{
  "title": "BAF2D",
  "assets": "config/assets.json",
  "effects": "config/effects.json",
  "weapons": "config/weapons.json",
  "startLevel": "config/levels/level01.json",

  "i18n": {
    "default": "en",
    "language": "auto",
    "available": ["en", "it"],
    "path": "config/lang/{lang}.json"
  },

  "display": {
    "targetHeight": 216,
    "minScale": 1,
    "maxScale": 10,
    "background": "#0b0b12"
  },

  "audio": {
    "masterVolume": 0.6
  },

  "mobile": {
    "requestFullscreen": true,
    "lockLandscape": true
  },

  "camera": {
    "smoothing": 10,
    "lookAhead": 24
  },

  "player": {
    "sprite": "soldier_rifle",
    "legsSprite": "soldier_legs",
    "legsTurnSpeed": 14,
    "backpedalAngleDeg": 100,
    "speed": 90,
    "hitbox": [10, 10],
    "faceMoveWhenIdle": true,
    "weapon": "rifle"
  },

  "input": {
    "keyboard": {
      "up": ["KeyW", "ArrowUp"],
      "down": ["KeyS", "ArrowDown"],
      "left": ["KeyA", "ArrowLeft"],
      "right": ["KeyD", "ArrowRight"],
      "fire": ["Space"],
      "debug": ["F3"],
      "debugNextWeapon": ["F4"]
    },
    "mouse": {
      "fireButton": 0
    },
    "touch": {
      "radius": 0.16,
      "deadZone": 0.12,
      "moveCurve": 1,
      "fireThreshold": 0.75,
      "holdToRepeat": true,
      "dynamic": true,
      "opacity": 0.7
    }
  },

  "debug": false
}
