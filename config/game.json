{
  "title": "BAF2D",
  "assets": "config/assets.json",
  "effects": "config/effects.json",
  "weapons": "config/weapons.json",
  "startLevel": "config/levels/level01.json",

  "i18n": {
    "default": "en",
    "language": "auto",
    "available": ["en", "it"],
    "path": "config/lang/{lang}.json"
  },

  "display": {
    "targetHeight": 216,
    "minScale": 1,
    "maxScale": 10,
    "background": "#0b0b12"
  },

  "audio": {
    "masterVolume": 0.6
  },

  "mobile": {
    "requestFullscreen": true,
    "lockLandscape": true
  },

  "hud": {
    "margin": 5,
    "font": "\"Courier New\", monospace",
    "fontSize": 7,
    "shadow": "#000000",
    "text": "#e8e8f0",
    "health": {
      "width": 60,
      "height": 5,
      "showValue": true,
      "color": "#d23c3c",
      "colorLight": "#f06a5a",
      "lowColor": "#ff2a2a",
      "lowThreshold": 0.3,
      "back": "#2a1414",
      "border": "#0b0b12",
      "trailColor": "#f4e2b0",
      "trailDelay": 0.35,
      "trailSpeed": 0.8,
      "icon": "#d23c3c"
    },
    "weapon": {
      "iconScale": 2,
      "ammoFontSize": 10,
      "pipsWidth": 60,
      "pipHeight": 3,
      "ammoColor": "#ffd36b",
      "spentColor": "#4a4436",
      "emptyColor": "#ff4a3a",
      "reloadColor": "#ffd36b",
      "reloadBack": "#2a2618"
    }
  },

  "camera": {
    "smoothing": 10,
    "lookAhead": 24
  },

  "player": {
    "sprite": "soldier_rifle",
    "legsSprite": "soldier_legs",
    "legsTurnSpeed": 14,
    "backpedalAngleDeg": 100,
    "speed": 90,
    "maxHealth": 100,
    "hitbox": [10, 10],
    "faceMoveWhenIdle": true,
    "weapon": "rifle"
  },

  "input": {
    "keyboard": {
      "up": ["KeyW", "ArrowUp"],
      "down": ["KeyS", "ArrowDown"],
      "left": ["KeyA", "ArrowLeft"],
      "right": ["KeyD", "ArrowRight"],
      "fire": ["Space"],
      "reload": ["KeyR"],
      "debug": ["F3"],
      "debugNextWeapon": ["F4"],
      "debugHurt": ["F5"],
      "debugHeal": ["F6"]
    },
    "mouse": {
      "fireButton": 0
    },
    "touch": {
      "radius": 0.16,
      "deadZone": 0.12,
      "moveCurve": 1,
      "fireThreshold": 0.75,
      "holdToRepeat": true,
      "dynamic": true,
      "opacity": 0.7,
      "buttons": {
        "reload": { "anchor": "right", "offset": [0, -2.1], "radius": 0.07, "icon": "reload" }
      }
    }
  },

  "debug": false,
  "debugDamage": 10
}
