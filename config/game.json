{
  "title": "BAF2D",
  "assets": "config/assets.json",
  "effects": "config/effects.json",
  "weapons": "config/weapons.json",
  "startLevel": "config/levels/level01.json",

  "i18n": {
    "default": "en",
    "language": "auto",
    "available": ["en", "it"],
    "path": "config/lang/{lang}.json"
  },

  "display": {
    "targetHeight": 216,
    "minScale": 1,
    "maxScale": 10,
    "background": "#0b0b12"
  },

  "audio": {
    "masterVolume": 0.6
  },

  "mobile": {
    "requestFullscreen": true,
    "lockLandscape": true
  },

  "teams": {
    "blue": { "color": "#3d7cf0", "dark": "#1c3c8c", "light": "#a4c4ff" },
    "red": { "color": "#e0402e", "dark": "#7a1a12", "light": "#ffa08c" }
  },

  "ctf": {
    "tickets": 400,
    "ticketsPerDeath": 1,
    "bleed": { "interval": 3, "mode": "advantage", "perFlag": 1 },
    "flag": {
      "radius": 32,
      "captureTime": 8,
      "neutralizeTime": 6,
      "extraCapturerSpeed": 0.5,
      "requireSight": true,
      "spawnDistance": [14, 24]
    },
    "capturedSound": "flag_captured",
    "lostSound": "flag_lost",
    "neutralizedSound": "flag_neutralized",
    "look": {
      "poleHeight": 22,
      "poleColor": "#c8c8d0",
      "finial": "#ffd36b",
      "baseColor": "#4a4a56",
      "baseLight": "#6a6a78",
      "shadow": "rgba(0,0,0,0.35)",
      "clothWidth": 9,
      "clothHeight": 6,
      "neutralColor": "#f0f0f0",
      "neutralDark": "#a8a8b0",
      "wave": 1.2,
      "waveSpeed": 6,
      "showZones": true,
      "zoneAlpha": 0.4,
      "zoneFillAlpha": 0.06,
      "zoneDash": 4
    }
  },

  "death": {
    "respawnDelay": 5,
    "respawnSound": "respawn",
    "maxCorpses": 12,
    "poolSprite": "blood_pool",
    "poolTime": 2.5,
    "dropWeapon": true,
    "dropDistance": 9
  },

  "matchEnd": {
    "delay": 2,
    "restartDelay": 0.8
  },

  "hud": {
    "margin": 5,
    "font": "\"Courier New\", monospace",
    "fontSize": 7,
    "shadow": "#000000",
    "text": "#e8e8f0",
    "health": {
      "width": 60,
      "height": 5,
      "showValue": true,
      "color": "#d23c3c",
      "colorLight": "#f06a5a",
      "lowColor": "#ff2a2a",
      "lowThreshold": 0.3,
      "back": "#2a1414",
      "border": "#0b0b12",
      "trailColor": "#f4e2b0",
      "trailDelay": 0.35,
      "trailSpeed": 0.8,
      "icon": "#d23c3c"
    },
    "grenades": {
      "show": true,
      "icon": "grenade",
      "iconScale": 1,
      "emptyColor": "#77706a"
    },
    "weapon": {
      "iconScale": 2,
      "ammoFontSize": 10,
      "pipsWidth": 60,
      "pipHeight": 3,
      "ammoColor": "#ffd36b",
      "spentColor": "#4a4436",
      "emptyColor": "#ff4a3a",
      "reloadColor": "#ffd36b",
      "reloadBack": "#2a2618"
    },
    "ctf": {
      "ticketFontSize": 8,
      "gap": 4,
      "barWidth": 36,
      "barHeight": 2,
      "barBack": "#1a1a22",
      "lowTickets": 0.1,
      "flagGap": 4,
      "flagFontSize": 6,
      "zoneBarWidth": 50,
      "zoneBarHeight": 3,
      "contestedColor": "#ffd36b",
      "toastTime": 2.5,
      "respawnY": 0.7,
      "respawnFontSize": 10,
      "killedColor": "#e8463a"
    }
  },

  "camera": {
    "smoothing": 10,
    "lookAhead": 24
  },

  "player": {
    "team": "blue",
    "sprite": "soldier_rifle",
    "legsSprite": "soldier_legs",
    "legsTurnSpeed": 14,
    "backpedalAngleDeg": 100,
    "speed": 90,
    "maxHealth": 100,
    "deadSprite": "soldier_dead",
    "deadOffset": 4,
    "deathSound": "player_death",
    "hitbox": [10, 10],
    "faceMoveWhenIdle": true,
    "weapon": "rifle",
    "grenade": "frag",
    "grenades": 2,
    "maxGrenades": 9
  },

  "input": {
    "keyboard": {
      "up": ["KeyW", "ArrowUp"],
      "down": ["KeyS", "ArrowDown"],
      "left": ["KeyA", "ArrowLeft"],
      "right": ["KeyD", "ArrowRight"],
      "fire": ["Space"],
      "reload": ["KeyR"],
      "grenade": ["KeyG"],
      "confirm": ["Enter", "NumpadEnter"],
      "debug": ["F3"],
      "debugNextWeapon": ["F4"],
      "debugHurt": ["F5"],
      "debugHeal": ["F6"],
      "debugGrenade": ["F7"],
      "debugTeam": ["F8"]
    },
    "mouse": {
      "fireButton": 0
    },
    "touch": {
      "radius": 0.16,
      "deadZone": 0.12,
      "moveCurve": 1,
      "fireThreshold": 0.75,
      "holdToRepeat": true,
      "dynamic": true,
      "opacity": 0.7,
      "buttons": {
        "reload": { "anchor": "right", "offset": [0, -2.1], "radius": 0.07, "icon": "reload" },
        "grenade": { "anchor": "right", "offset": [-1.9, -1.3], "radius": 0.065, "icon": "grenade" },
        "debugHurt": { "anchor": "left", "offset": [-0.6, -2.1], "radius": 0.055, "icon": "hurt", "color": "rgba(255,110,200,0.9)", "debugOnly": true },
        "debugHeal": { "anchor": "left", "offset": [0.6, -2.1], "radius": 0.055, "icon": "heal", "color": "rgba(120,255,160,0.9)", "debugOnly": true }
      }
    }
  },

  "debug": false,
  "debugDamage": 10
}
